# Copiez ce fichier en `.env` (jamais versionné) et ajustez. Toutes les variables sont optionnelles.

# --- Modèles locaux (Ollama) -----------------------------------------------------------
# LLM des étapes 3 et 5. 16 Go de RAM ou plus : qwen3:8b ; 8 Go : qwen3:4b.
LLM_MODEL=qwen3:8b
# Embeddings des collections de veille (familles, entreprises). Multilingue.
EMBED_MODEL=bge-m3
OLLAMA_HOST=http://localhost:11434
# Température du LLM et délai max d'un appel (secondes)
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=180

# --- Modes -----------------------------------------------------------------------------
# DEMO_MODE=true : rejoue les sorties figées de data/demo/ (aucun réseau, aucun LLM).
DEMO_MODE=false
# DUMMY_MODE=true : réponses factices conformes au contrat (pour l'équipe Tech).
DUMMY_MODE=false

# --- Collecte --------------------------------------------------------------------------
# "french", "english" ou "french,english" (une requête GDELT par langue, puis fusion).
NEWS_LANGUAGES=french
# Optionnel : clé GNews (https://gnews.io) pour récupérer les descriptions.
GNEWS_API_KEY=
# Intervalle minimal entre deux requêtes GDELT (secondes ; GDELT demande ~5 s).
GDELT_MIN_INTERVAL_S=5
HTTP_TIMEOUT_S=20
# Délai max pour récupérer le texte d'un article retenu (repli sur le titre au-delà).
ARTICLE_TIMEOUT_S=8

# --- Filtre (similarité cosinus, 0 à 1) ------------------------------------------------
FILTER_THRESHOLD=0.50
# Surcharges par langue (laisser vide pour utiliser FILTER_THRESHOLD)
FILTER_THRESHOLD_FR=
FILTER_THRESHOLD_EN=

# --- Étape 5 ---------------------------------------------------------------------------
MAX_COMPANIES_PER_NEWS=5

# --- API -------------------------------------------------------------------------------
API_HOST=0.0.0.0
# 8001 pour ne pas entrer en conflit avec le RAG histoire (rag/api.py sur 8000)
API_PORT=8001
LOG_LEVEL=INFO
